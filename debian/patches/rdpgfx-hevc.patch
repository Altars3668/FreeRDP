+		 * decides which one. */
+		if (!h264_context_set_option(surface->h264, H264_CONTEXT_OPTION_HEVC, 1))
+			return ERROR_INTERNAL_ERROR;
+
+		if (!h264_context_reset(surface->h264, surface->width, surface->height))
+			return ERROR_INTERNAL_ERROR;
+	}
