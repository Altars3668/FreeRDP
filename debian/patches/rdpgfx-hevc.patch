+/**
+ * An HEVC surface command carries the AVC420 metablock, then a table of NAL unit
+ * lengths, then the bitstream. The table is what the Microsoft client needs to
+ * hand its Media Foundation decoder as MF_NALU_LENGTH_INFORMATION; nothing here
+ * needs it, since the bitstream is self-delimiting, so it is read past.
+ */
+static UINT rdpgfx_decode_HEVC(RDPGFX_PLUGIN* gfx, RDPGFX_SURFACE_COMMAND* cmd)
+{
+	RDPGFX_AVC420_BITMAP_STREAM hevc = WINPR_C_ARRAY_INIT;
+	UINT32 cbNaluLengths = 0;
+	wStream* s = Stream_New(cmd->data, cmd->length);
+	UINT error = CHANNEL_RC_OK;
+
+	if (!s)
+	{
+		WLog_Print(gfx->base.log, WLOG_ERROR, "Stream_New failed!");
+		return CHANNEL_RC_NO_MEMORY;
+	}
+
+	error = rdpgfx_read_h264_metablock(gfx, s, &(hevc.meta));
+	if (error != CHANNEL_RC_OK)
+	{
+		Stream_Free(s, FALSE);
+		WLog_Print(gfx->base.log, WLOG_ERROR,
+		           "rdpgfx_read_h264_metablock failed with error %" PRIu32 "!", error);
+		return error;
+	}
+
+	if (!Stream_CheckAndLogRequiredLengthWLog(gfx->base.log, s, 4))
+	{
+		Stream_Free(s, FALSE);
+		free_h264_metablock(&hevc.meta);
+		return ERROR_INVALID_DATA;
+	}
+
+	Stream_Read_UINT32(s, cbNaluLengths); /* cbNaluLengths (4 bytes) */
+
+	if (!Stream_CheckAndLogRequiredLengthWLog(gfx->base.log, s, cbNaluLengths))
+	{
+		Stream_Free(s, FALSE);
+		free_h264_metablock(&hevc.meta);
+		return ERROR_INVALID_DATA;
+	}
+
+	Stream_Seek(s, cbNaluLengths); /* naluLengths (cbNaluLengths bytes) */
+
+	hevc.data = Stream_Pointer(s);
+	hevc.length = (UINT32)Stream_GetRemainingLength(s);
+	Stream_Free(s, FALSE);
+	cmd->extra = (void*)&hevc;
+
+	error = logSurfaceCommand(gfx, cmd);
+
+	free_h264_metablock(&hevc.meta);
+	cmd->extra = nullptr;
+	return error;
+}
+#endif
