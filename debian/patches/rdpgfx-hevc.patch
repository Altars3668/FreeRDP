+/*
+ * The NALU length table an HEVC surface command carries between the metablock
+ * and the bitstream.
+ *
+ * mstscax.dll's HevcDecoder::DecodeHeader is handed the whole of bitmapData and
+ * walks it in one pass: numRegionRects, the rectangles and quality values, then
+ * a byte count here, then that many bytes of UINT32 lengths -- they become the
+ * MF_NALU_LENGTH_INFORMATION blob its Media Foundation decoder wants. Without
+ * the table it reads the first four bytes of the bitstream as the count,
+ * decides 0x01000000 is longer than what is left, and refuses the frame.
+ *
+ * One length per NAL unit, each counting its start code prefix, so that the
+ * lengths sum to the bitstream.
+ */
+static UINT32 rdpgfx_hevc_nalu_offsets(const BYTE* data, UINT32 length, UINT32* offsets)
+{
+	UINT32 count = 0;
+
+	for (UINT32 i = 0; i + 3 <= length; i++)
+	{
+		if (data[i] != 0 || data[i + 1] != 0 || data[i + 2] != 1)
+			continue;
+
+		/* A four-byte start code begins one byte before the three-byte one
+		 * this finds, and the length has to cover the whole prefix. */
+		if (count < RDPGFX_HEVC_MAX_NALUS)
+			offsets[count] = (i > 0 && data[i - 1] == 0) ? i - 1 : i;
+
+		count++;
+		i += 2;
+	}
+
+	return count;
+}
+
+static UINT rdpgfx_write_hevc_nalu_lengths(wLog* log, wStream* s, const BYTE* data, UINT32 length)
+{
+	UINT32 offsets[RDPGFX_HEVC_MAX_NALUS] = { 0 };
+	const UINT32 count = rdpgfx_hevc_nalu_offsets(data, length, offsets);
+
+	if ((count == 0) || (count > RDPGFX_HEVC_MAX_NALUS) || (offsets[0] != 0))
+	{
+		WLog_Print(log, WLOG_ERROR,
+		           "cannot describe the HEVC bitstream: %" PRIu32 " NAL units, first at %" PRIu32,
+		           count, offsets[0]);
+		return ERROR_INVALID_DATA;
+	}
+
+	if (!Stream_EnsureRemainingCapacity(s, 4ULL + 4ULL * count + 1ULL))
+		return ERROR_INTERNAL_ERROR;
+
+	Stream_Write_UINT32(s, count * 4); /* cbNaluLengths (4 bytes) */
+
+	for (UINT32 i = 0; i < count; i++)
+	{
+		const UINT32 end = (i + 1 < count) ? offsets[i + 1] : length;
+
+		Stream_Write_UINT32(s, end - offsets[i]); /* naluLengths[i] (4 bytes) */
+	}
+
+	/*
+	 * One more byte before the bitstream, and it is not padding: without it the
+	 * client starts the bitstream one byte early and every frame is rejected.
+	 *
+	 * mstscax.dll's HevcDecoder::DecodeHeader hands its caller the header size
+	 * it consumed, computed as cbNaluLengths + 10 * numRegionRects + 8 -- and
+	 * + 9 instead when a mode flag on the decoder is set, which it is for a
+	 * plain 4:2:0 session. In that mode it also reads this byte and keeps bit 0.
+	 * Write it as zero: the header size is what the frame turns on, and bit 0
+	 * clear is what the client was seen to be given.
+	 *
+	 * The symptom of omitting it is worth naming, because it looks like a codec
+	 * problem and is not: the NAL lengths still sum to the bitstream, so with
+	 * the start one byte late the last unit runs one byte past the buffer, the
+	 * Media Foundation decode fails, and mstsc answers by turning off hardware
+	 * decoding for the whole session -- H.264 included.
+	 */
+	Stream_Write_UINT8(s, 0);
+
+	return CHANNEL_RC_OK;
+}
