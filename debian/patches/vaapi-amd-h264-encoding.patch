-			h264->iStride[1] = stride;
-			h264->iStride[2] = 0;
-		}
-		else /* I420 */
-		{
-			h264->iStride[0] = stride;
-			h264->iStride[1] = (stride + 1) / 2;
-			h264->iStride[2] = (stride + 1) / 2;
-		}
+		h264->iStride[0] = stride;
+		h264->iStride[1] = (stride + 1) / 2;
+		h264->iStride[2] = (stride + 1) / 2;
 
 		for (size_t x = 0; x < nPlanes; x++)
 		{
@@ -725,6 +720,12 @@ static BOOL h264_context_init(H264_CONTE
 		if (!subsystem || !subsystem->Init)
 			break;
 
+		/* When hw accel is requested, skip pure-software subsystems
+		 * so that FFmpeg/VAAPI gets a chance to initialize */
+		if (h264->Compressor && h264->hwAccel &&
+		    strcmp(subsystem->name, "OpenH264") == 0)
+			continue;
+
 		if (subsystem->Init(h264))
 		{
 			h264->subsystem = subsystem;
