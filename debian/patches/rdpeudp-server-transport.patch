+	return WTSVirtualChannelWrite(vcm->drdynvc_channel, (PCHAR)pduBuf, (UINT32)pos, &written);
+}
+
+BOOL WTSVirtualChannelManagerProcessUdpData(HANDLE hServer, const BYTE* data, size_t len)
+{
+	WTSVirtualChannelManager* vcm = (WTSVirtualChannelManager*)hServer;
+	WINPR_ASSERT(vcm);
+
+	if (!vcm->drdynvc_channel || vcm->drdynvc_state != DRDYNVC_STATE_READY)
+		return FALSE;
+
+	if (!data || len == 0 || len > UINT32_MAX)
+		return FALSE;
+
+	rdpPeerChannel* channel = vcm->drdynvc_channel;
+
+	/* Write the raw DVC PDU into the drdynvc channel's receive stream
+	 * and process it exactly as if it arrived on TCP. */
+	Stream_SetPosition(channel->receiveData, 0);
+	if (!Stream_EnsureRemainingCapacity(channel->receiveData, len))
+		return FALSE;
+
+	Stream_Write(channel->receiveData, data, len);
+	BOOL ret = wts_read_drdynvc_pdu(channel);
+	Stream_SetPosition(channel->receiveData, 0);
+	return ret;
+}
