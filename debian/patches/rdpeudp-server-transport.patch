 			if (settings->SupportMultitransport &&
 			    ((settings->MultitransportFlags & INITIATE_REQUEST_PROTOCOL_UDPFECR) != 0))
 			{
+				/*
+				 * Notify the application so it can register the cookie with its
+				 * RDPEUDP server before the client SYN arrives.
+				 *
+				 * Inside the check, not before it. Standing the listener up
