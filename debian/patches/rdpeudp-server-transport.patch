Index: freerdp3-3.30.0+dfsg/include/freerdp/rdpeudp.h
===================================================================
--- /dev/null
+++ freerdp3-3.30.0+dfsg/include/freerdp/rdpeudp.h
@@ -0,0 +1,95 @@
+/**
+ * FreeRDP: A Remote Desktop Protocol Implementation
+ * RDPEUDP/RDPEMT server transport (MS-RDPEUDP, MS-RDPEMT)
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *     http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+#ifndef FREERDP_RDPEUDP_H
+#define FREERDP_RDPEUDP_H
+
+#include <freerdp/api.h>
+#include <freerdp/types.h>
+#include <winpr/wtypes.h>
+
+/*
+ * What a server needs to carry a session's dynamic virtual channels over UDP.
+ *
+ * The server owns one UDP socket and demultiplexes datagrams to per-client
+ * connections. A connection is claimed by the cookie the core hands out with
+ * the multitransport request, which is what ties an arriving SYN to the TCP
+ * session that asked for it.
+ *
+ * This is the subset an embedder uses; the wire protocol itself stays private.
+ */
+
+#ifdef __cplusplus
+extern "C"
+{
+#endif
+
+	typedef struct rdp_rdpeudp_server rdpRdpeudpServer;
+	typedef struct rdp_rdpeudp_conn rdpRdpeudpConn;
+
+	/* Called once the DTLS handshake completes and the connection can carry data. */
+	typedef void (*RdpeudpConnectedCb)(rdpRdpeudpConn* conn, void* userdata);
+
+	FREERDP_API rdpRdpeudpServer* rdpeudp_server_new(int port);
+	FREERDP_API void rdpeudp_server_free(rdpRdpeudpServer* server);
+
+	/* The socket to poll; the embedder drives check_fds when it is readable. */
+	FREERDP_API int rdpeudp_server_get_fd(rdpRdpeudpServer* server);
+	FREERDP_API int rdpeudp_server_check_fds(rdpRdpeudpServer* server);
+
+	/* DTLS needs the same certificate the TCP side presents. */
+	FREERDP_API BOOL rdpeudp_server_set_tls_credentials(rdpRdpeudpServer* server,
+	                                                    const char* cert_file,
+	                                                    const char* key_file);
+
+	/* Claim the connection a client will open with this cookie. */
+	FREERDP_API rdpRdpeudpConn* rdpeudp_server_register_cookie(rdpRdpeudpServer* server,
+	                                                           const BYTE* cookie,
+	                                                           RdpeudpConnectedCb cb,
+	                                                           void* userdata);
+
+	FREERDP_API void rdpeudp_conn_free(rdpRdpeudpConn* conn);
+
+	/*
+	 * Hand a connected tunnel to the session it belongs to.
+	 *
+	 * From here the core decides when to use it: after Soft-Sync has moved the
+	 * graphics channel across, and once the path has carried traffic both ways.
+	 * Embedders should not need to know either rule.
+	 */
+	FREERDP_API void freerdp_peer_set_udp_connection(freerdp_peer* peer,
+	                                                 rdpRdpeudpConn* conn);
+
+	/* Application data, with the RDPEMT framing already stripped. */
+	FREERDP_API int rdpemt_conn_read(rdpRdpeudpConn* conn, BYTE* data, size_t len);
+
+	/*
+	 * Is there anything waiting to be read?
+	 *
+	 * The tunnel is drained by the thread that owns the channel manager, and
+	 * that thread only looks when it has something of its own to do. Whoever
+	 * receives the datagrams can use this to wake it -- otherwise receiving
+	 * depends on sending, and a session waiting on acknowledgements that have
+	 * already arrived will wait for ever.
+	 */
+	FREERDP_API BOOL rdpeudp_conn_has_pending_data(rdpRdpeudpConn* conn);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* FREERDP_RDPEUDP_H */
