+BOOL WTSVirtualChannelManagerSendSoftSyncRequest(HANDLE hServer, UINT32 tunnelType)
+{
+	WTSVirtualChannelManager* vcm = (WTSVirtualChannelManager*)hServer;
+	WINPR_ASSERT(vcm);
