+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+#ifndef FREERDP_LIB_CORE_RDPEUDP_H
+#define FREERDP_LIB_CORE_RDPEUDP_H
+
+#include <freerdp/api.h>
+#include <winpr/stream.h>
+#include <winpr/synch.h>
+
+/* ============================================================
+ * MS-RDPEUDP protocol constants (section 2.2)
+ * ============================================================ */
+
+/* RDPUDP_FLAG values (v1 header uFlags, big-endian on wire).
+ * Derived from mstsc SYN analysis: flags=0x1801 = SYN|SYNEX|CORRELATIONID.
+ */
+#define RDPUDP_FLAG_SYN            0x0001
+#define RDPUDP_FLAG_FIN            0x0002
+#define RDPUDP_FLAG_ACK            0x0004
+#define RDPUDP_FLAG_DATA           0x0008
+#define RDPUDP_FLAG_FEC            0x0010
+#define RDPUDP_FLAG_CN             0x0020
+#define RDPUDP_FLAG_CWR            0x0040
+/*
+ * From 0x0080 up these were named one position out of step. The numbers the
+ * code uses were right -- the one place that matters skips the
+ * ACK_OF_ACKS payload on 0x0100, which is correct -- but the names were not,
+ * and mstsc sends 0x0404 on a DATA/ACK packet, which reads as ACK|ACKDELAYED
+ * and not as ACK|SYNLOSSY. Anyone reaching for a name would have got the
+ * wrong bit.
+ */
+#define RDPUDP_FLAG_SACK_OPTION    0x0080
+#define RDPUDP_FLAG_ACKOFACKS      0x0100
+#define RDPUDP_FLAG_SYNLOSSY       0x0200
+#define RDPUDP_FLAG_ACKDELAYED     0x0400
+#define RDPUDP_FLAG_CORRELATIONID  0x0800
+#define RDPUDP_FLAG_SYNEX          0x1000
+
+/* RDPEUDP version values (section 2.2.2.5) */
+/*
+ * MS-RDPEUDP 2.2.2.5. Version 3 is the one that carries the RDPEUDP2 packet
+ * format; versions 1 and 2 use the original header. Naming 0x0101 "version 2"
+ * made a client offering 0x0002 negotiate down to version 1, where nothing is
+ * implemented, and the connection went quiet after the handshake.
+ */
+#define RDPUDP_VERSION_1           0x0001
+#define RDPUDP_VERSION_2           0x0002
+#define RDPUDP_VERSION_3           0x0101
+
+/* RDPEUDP2 packet type flags (section 2.2.3) */
+#define RDPEUDP2_ACK               0x0001
+#define RDPEUDP2_OVERSIZE          0x0002
+#define RDPEUDP2_DATA              0x0004
+#define RDPEUDP2_ACKVEC            0x0008
+
+/* Default MTU values */
+#define RDPEUDP_MTU_DEFAULT        1232
+
+/* Connection state */
+typedef enum
+{
+	RDPEUDP_STATE_CLOSED = 0,
+	RDPEUDP_STATE_SYN_RECEIVED,    /* server got SYN, sent SYN-ACK */
+	RDPEUDP_STATE_ESTABLISHED,     /* 3-way handshake complete */
+	RDPEUDP_STATE_DTLS_HANDSHAKE,  /* DTLS handshake in progress */
+	RDPEUDP_STATE_CONNECTED,       /* DTLS established, data can flow */
+	RDPEUDP_STATE_FIN_SENT
+} RdpeudpState;
+
+/* Forward declarations */
+#include <freerdp/rdpeudp.h>
+
+/* ============================================================
+ * Callback: invoked when a UDP connection is fully established
+ * (DTLS handshake complete). The application can then route
+ * data over the UDP channel.
+ * ============================================================ */
+
+
+/*
+ * Whether the client has sent application data over this connection.
+ *
+ * The handshake only proves the client can reach us; it says nothing about our
+ * datagrams reaching the client. Until traffic has come back the path is
+ * unproven, and the graphics channel must stay on TCP -- routing it onto a path
+ * that turns out to be one-way loses the session's picture entirely.
+ */
+FREERDP_LOCAL BOOL rdpeudp_conn_path_confirmed(rdpRdpeudpConn* conn);
+
+/* ============================================================
+ * Server: manages the single UDP socket and demultiplexes
+ * incoming datagrams to per-client connections.
+ * ============================================================ */
+
+FREERDP_API rdpRdpeudpServer* rdpeudp_server_new(int port);
+FREERDP_API void rdpeudp_server_free(rdpRdpeudpServer* server);
+
+/* Get the UDP socket fd for event polling */
+FREERDP_API int rdpeudp_server_get_fd(rdpRdpeudpServer* server);
+
+/* Process incoming UDP datagrams (call when socket is readable) */
+FREERDP_API int rdpeudp_server_check_fds(rdpRdpeudpServer* server);
+
+/* Register a pending connection with a security cookie.
+ * When a SYN arrives matching this cookie, a new rdpRdpeudpConn is created. */
+FREERDP_API rdpRdpeudpConn* rdpeudp_server_register_cookie(
+    rdpRdpeudpServer* server,
+    const BYTE cookie[16],
+    RdpeudpConnectedCb callback,
+    void* userdata);
+
+/* Set TLS credentials for DTLS (must match TCP TLS cert per MS-RDPEMT) */
+FREERDP_API BOOL rdpeudp_server_set_tls_credentials(
+    rdpRdpeudpServer* server,
+    const char* cert_pem,
+    const char* key_pem);
+
+/* ============================================================
+ * Connection: per-client UDP session
+ * ============================================================ */
+
+FREERDP_API RdpeudpState rdpeudp_conn_get_state(rdpRdpeudpConn* conn);
+
+/* Get the event handle for this connection (signaled when data available) */
+FREERDP_API HANDLE rdpeudp_conn_get_event(rdpRdpeudpConn* conn);
+
+/* Get max DVC PDU size that fits in a single v1 UDP packet within MTU */
+FREERDP_API size_t rdpeudp_conn_get_max_pdu(rdpRdpeudpConn* conn);
+
+/* Send data over the DTLS-secured UDP channel */
+FREERDP_API int rdpeudp_conn_write(rdpRdpeudpConn* conn, const BYTE* data, size_t len);
+
+/* Receive data from the DTLS-secured UDP channel */
+FREERDP_API int rdpeudp_conn_read(rdpRdpeudpConn* conn, BYTE* data, size_t len);
+
+FREERDP_API void rdpeudp_conn_free(rdpRdpeudpConn* conn);
+
+/* ============================================================
+ * RDPEMT transport layer: wraps rdpeudp_conn with MS-RDPEMT
+ * Data framing (action=0x00 Tunnel Data PDU).
+ * Provides a BIO for use with rdpTransport.
+ * ============================================================ */
+
+/* Write an RDP PDU via RDPEMT Data framing over the UDP tunnel.
+ * Returns bytes of payload written (excluding RDPEMT header), or < 0 on error. */
+FREERDP_API int rdpemt_conn_write(rdpRdpeudpConn* conn, const BYTE* data, size_t len);
+
+/* Read an RDP PDU from the UDP tunnel (RDPEMT header already stripped).
+ * Returns bytes read, 0 if no data, or < 0 on error. */
+FREERDP_API int rdpemt_conn_read(rdpRdpeudpConn* conn, BYTE* data, size_t len);
+
+/* Get the UDP socket fd (for integrating into an external event loop) */
+FREERDP_API int rdpeudp_conn_get_fd(rdpRdpeudpConn* conn);
+
+#endif /* FREERDP_LIB_CORE_RDPEUDP_H */
