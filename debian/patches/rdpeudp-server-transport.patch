Index: freerdp3-3.30.0+dfsg/libfreerdp/core/multitransport.c
===================================================================
--- freerdp3-3.30.0+dfsg.orig/libfreerdp/core/multitransport.c
+++ freerdp3-3.30.0+dfsg/libfreerdp/core/multitransport.c
@@ -36,6 +36,7 @@ struct rdp_multitransport
 	UINT32 reliableReqId;
 
 	BYTE reliableCookie[RDPUDP_COOKIE_LEN];
+	BOOL reliableCookieReady;
 	BYTE reliableCookieHash[RDPUDP_COOKIE_HASHLEN];
 };
 
@@ -113,6 +114,20 @@ static BOOL multitransport_request_send(
 	Stream_Zero(s, 2);                          /* reserved (2 bytes) */
 	Stream_Write(s, cookie, RDPUDP_COOKIE_LEN); /* securityCookie (16 bytes) */
 
+	/*
+	 * The securityCookie is not logged.
+	 *
+	 * It is the whole of the authorization for a UDP tunnel to join this
+	 * session: present it and the tunnel is created. A hexdump of it stood
+	 * here, and the sweep that removed exactly this shape from the transport
+	 * did not reach into this file -- so the capability was still being handed
+	 * to anyone who could read the journal. The format loop also ran whether or
+	 * not debug output was enabled.
+	 */
+	WLog_DBG(TAG,
+	         "multitransport_request_send: requestId=%" PRIu32 ", protocol=0x%04" PRIx16,
+	         reqId, reqProto);
+
 	return rdp_send_message_channel_pdu(multi->rdp, s, sec_flags | SEC_TRANSPORT_REQ);
 }
 
@@ -126,8 +141,12 @@ state_run_t multitransport_server_reques
 	if (reqProto == INITIATE_REQUEST_PROTOCOL_UDPFECR)
 	{
 		multi->reliableReqId = reqId++;
-		if (winpr_RAND(multi->reliableCookie, sizeof(multi->reliableCookie)) < 0)
-			return STATE_RUN_FAILED;
+		if (!multi->reliableCookieReady)
+		{
+			if (winpr_RAND(multi->reliableCookie, sizeof(multi->reliableCookie)) < 0)
+				return STATE_RUN_FAILED;
+			multi->reliableCookieReady = TRUE;
+		}
 
 		return multitransport_request_send(multi, multi->reliableReqId, reqProto,
 		                                   multi->reliableCookie)
@@ -239,3 +258,23 @@ void multitransport_free(rdpMultitranspo
 {
 	free(multitransport);
 }
+
+const BYTE* multitransport_get_cookie(rdpMultitransport* multi)
+{
+	WINPR_ASSERT(multi);
+
+	/*
+	 * The application is told the cookie so it can have a UDP listener waiting
+	 * before the client's SYN arrives, which means it is asked for the cookie
+	 * before the request is sent. Generate it on first use rather than when the
+	 * request goes out: asking first and generating later handed the caller
+	 * sixteen zeroes, and every tunnel it then accepted failed to match.
+	 */
+	if (!multi->reliableCookieReady)
+	{
+		if (winpr_RAND(multi->reliableCookie, sizeof(multi->reliableCookie)) < 0)
+			return NULL;
+		multi->reliableCookieReady = TRUE;
+	}
+	return multi->reliableCookie;
+}
